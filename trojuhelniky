<!doctype html>
<html lang="cs">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Atlas konstrukcí trojúhelníku</title>
<style>
:root{
  --bg:#f6f7fb; --panel:#fff; --ink:#172033; --muted:#64748b; --line:#dbe2ea;
  --accent:#315efb; --soft:#eef3ff; --good:#137a43; --warn:#a85b00; --bad:#b42318;
}
*{box-sizing:border-box}
body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:var(--bg);color:var(--ink)}
button,input,select{font:inherit}
.app{min-height:100vh;display:grid;grid-template-columns:330px 1fr}
aside{background:#0f172a;color:white;padding:22px 16px;position:sticky;top:0;height:100vh;overflow:auto}
.brand{font-size:22px;font-weight:800;line-height:1.15;margin-bottom:6px}
.brand small{display:block;color:#cbd5e1;font-size:13px;font-weight:500;margin-top:7px;line-height:1.45}
.search{width:100%;margin:16px 0 10px;border:0;border-radius:11px;padding:11px 12px;background:#1e293b;color:white;outline:none}
.filters{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}
.filters button{border:1px solid #334155;background:#172033;color:#cbd5e1;border-radius:999px;padding:6px 9px;cursor:pointer;font-size:12px}
.filters button.active{background:white;color:#0f172a;border-color:white}
.problem-list{display:grid;gap:6px}
.problem-item{width:100%;text-align:left;border:0;background:transparent;color:#dbeafe;padding:9px 10px;border-radius:9px;cursor:pointer}
.problem-item:hover{background:#1e293b}
.problem-item.active{background:#315efb;color:#fff}
.problem-item b{display:block;font-size:14px}
.problem-item span{font-size:12px;color:#94a3b8}
.problem-item.active span{color:#dbeafe}
main{padding:28px;min-width:0}
.topbar{display:flex;align-items:center;gap:10px;justify-content:space-between;margin-bottom:18px}
.navbtn{border:1px solid var(--line);background:white;border-radius:10px;padding:9px 12px;cursor:pointer}
.progress{color:var(--muted);font-size:14px}
.grid{display:grid;grid-template-columns:minmax(360px,1fr) minmax(420px,1.15fr);gap:20px;align-items:start}
.card{background:white;border:1px solid var(--line);border-radius:18px;padding:20px;box-shadow:0 4px 18px rgba(15,23,42,.04)}
.eyebrow{font-size:12px;font-weight:800;color:var(--accent);text-transform:uppercase;letter-spacing:.08em}
h1{font-size:30px;line-height:1.15;margin:6px 0 10px}
.lead{color:var(--muted);line-height:1.6;margin:0 0 16px}
.badges{display:flex;flex-wrap:wrap;gap:7px;margin:12px 0 18px}
.badge{background:var(--soft);color:#2448bd;border-radius:999px;padding:6px 9px;font-size:12px;font-weight:700}
.kv{display:grid;grid-template-columns:135px 1fr;gap:8px 12px;margin:12px 0}
.kv dt{color:var(--muted);font-weight:700}
.kv dd{margin:0}
.notice{border-left:4px solid var(--accent);background:#f8faff;padding:12px 14px;border-radius:10px;line-height:1.55;margin:15px 0}
.notice.warn{border-color:#e99800;background:#fff8e8}
.solution-toggle{width:100%;border:0;background:#137a43;color:white;padding:12px 14px;border-radius:11px;font-weight:800;cursor:pointer;margin-top:8px}
.solution{display:none;margin-top:16px}
.solution.open{display:block}
.steps{display:grid;gap:9px;margin-top:10px}
.step{border:1px solid var(--line);border-radius:11px;padding:11px 12px;cursor:pointer}
.step.active{border-color:#8ca6ff;background:#f7f9ff}
.step .num{display:inline-grid;place-items:center;width:25px;height:25px;border-radius:50%;background:#e9efff;color:#2448bd;font-weight:800;font-size:12px;margin-right:8px}
.step strong{font-size:14px}
.step p{margin:7px 0 0 33px;color:#475569;font-size:14px;line-height:1.5}
.construction{margin-top:15px;padding:14px;background:#f8fafc;border-radius:11px;border:1px solid var(--line)}
.construction h3{margin:0 0 8px;font-size:15px}
.construction ol{margin:0;padding-left:22px;line-height:1.62;color:#334155}
.diagram-card{position:sticky;top:20px}
.diagram-head{display:flex;gap:8px;justify-content:space-between;align-items:center;margin-bottom:12px}
.diagram-title{font-size:16px;font-weight:800}
.step-counter{font-size:13px;color:var(--muted)}
svg{width:100%;height:auto;aspect-ratio:4/3;background:linear-gradient(180deg,#fff,#fbfdff);border:1px solid var(--line);border-radius:14px}
.diagram-controls{display:flex;gap:8px;margin-top:10px}
.diagram-controls button{flex:1;border:1px solid var(--line);background:white;border-radius:10px;padding:9px;cursor:pointer}
.diagram-controls button.primary{background:var(--accent);border-color:var(--accent);color:white}
.legend{display:flex;flex-wrap:wrap;gap:12px;margin-top:10px;color:var(--muted);font-size:12px}
.legend i{display:inline-block;width:18px;border-top:3px solid;margin-right:5px;vertical-align:middle}
.l-given{border-color:#172033!important}.l-help{border-color:#e99800!important}.l-final{border-color:#137a43!important}
.teacher-note{margin-top:18px;border-top:1px solid var(--line);padding-top:14px;color:#475569;line-height:1.55;font-size:14px}
sub{font-size:.72em;line-height:0;vertical-align:sub}
.home{max-width:980px;margin:auto}
.home h1{font-size:38px}
.catalog{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:20px 0}
.stat{background:white;border:1px solid var(--line);border-radius:14px;padding:18px}
.stat b{display:block;font-size:26px}
.stat span{color:var(--muted);font-size:13px}
@media(max-width:1000px){
 .app{grid-template-columns:1fr}
 aside{position:relative;height:auto}
 .grid{grid-template-columns:1fr}
 .diagram-card{position:relative;top:auto}
}
@media(max-width:600px){
 main{padding:16px}
 .catalog{grid-template-columns:1fr}
 h1{font-size:25px}
 .kv{grid-template-columns:1fr}
}
@media print{
 aside,.topbar,.diagram-controls,.solution-toggle{display:none!important}
 .app{display:block}.grid{grid-template-columns:1fr}.card{box-shadow:none;break-inside:avoid}.solution{display:block}
 .diagram-card{position:relative;top:auto}
}
</style>
</head>
<body>
<div class="app">
<aside>
  <div class="brand">△ Atlas konstrukcí
    <small>Trojúhelníky krok po kroku: zápis konstrukce + grafické řešení.</small>
  </div>
  <input id="search" class="search" placeholder="Hledat: těžnice, výška, R, r…">
  <div id="filters" class="filters"></div>
  <div id="problemList" class="problem-list"></div>
</aside>

<main>
  <div class="topbar">
    <button class="navbtn" id="prevProblem">← Předchozí</button>
    <div class="progress" id="progress"></div>
    <button class="navbtn" id="nextProblem">Další →</button>
  </div>
  <div id="content"></div>
</main>
</div>

